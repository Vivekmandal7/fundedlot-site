# Generated by build.mjs — Apache/LiteSpeed twin of _headers + _redirects.
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On
# Force HTTPS and canonicalize fundedlot.com → www.fundedlot.com (keep ACME paths reachable)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^fundedlot\.com$ [NC]
RewriteRule ^(.*)$ https://www.fundedlot.com/$1 [R=301,L]

# Brand-misspelling and vanity paths
RedirectMatch 301 ^/funded-lot(/.*)?$ /
RedirectMatch 301 ^/fundedlot(/.*)?$ /
RedirectMatch 301 ^/app/?$ /download/
RedirectMatch 301 ^/get/?$ /download/

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <Files "sitemap.xml">
    Header set Cache-Control "public, max-age=3600"
  </Files>
  <Files "robots.txt">
    Header set Cache-Control "public, max-age=3600"
  </Files>
  <Files "llms.txt">
    Header set Cache-Control "public, max-age=3600"
  </Files>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
